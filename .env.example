# Copy to .env and adjust. Nothing here is a secret; keep real secrets out of git.
# Docker Compose works without a .env file: every value below has a default in docker-compose.yml.

# Simulator the backend reads from when it runs outside Compose (Compose sets its own)
SIMULATOR_URL=http://localhost:8000

# Simulator pacing. SIMULATION_SPEED is about ticks per second. The simulator ships with 8, but at about 5 ticks a
# second the world moves while it is being read, so FuelWatch reports DEGRADED and holds shipments until it slows.
SIMULATION_SPEED=1
TICK_MINUTES=15
SIMULATOR_START_MODE=paused

# Shared secret for approve, reject and control requests (header X-Operator-Token).
# Under Compose, leaving this empty means the demo token "demo-token". A backend started by hand with it empty
# refuses all of those requests. Set your own value before anyone else can reach the ports.
OPERATOR_TOKEN=

# Optional: personal accounts as name:role:key,name:role:key. The role is operator (approve and reject) or supervisor
# (also override the safety gate, change the autopilot and drive the simulator). Keys need 12 characters or more and no
# commas; make your own, for example with: openssl rand -hex 16
# With accounts set, the audit trail records who did what and OPERATOR_TOKEN stops working. Remove an entry and run
# `docker compose up -d` again to revoke that person.
ACCOUNTS=

# Optional: pre-fill the token in the console. The value is compiled into the page that every browser downloads,
# so anyone who can open the console could then approve shipments. Leave empty unless that is acceptable.
# Changing it needs a rebuild: docker compose up -d --build frontend
DASHBOARD_PREFILL_TOKEN=

# Backend tuning (seconds)
REQUEST_TIMEOUT=3
POLL_INTERVAL=0.5
REFRESH_MAX_AGE=5
READY_MAX_AGE=15

# Load shedding: most requests in flight before the backend answers 503 (optional reads are refused first; health
# probes and operator actions never are), and most browser event streams. 0 turns a limit off.
SHED_OPTIONAL_LIMIT=128
SHED_ESSENTIAL_LIMIT=256
SHED_STREAM_LIMIT=200

# Allocation policy: lp (linear programme, falls back to greedy, then rules), greedy or rules
ALLOCATOR=lp

# Alerts in Discord (optional). In Discord: channel settings > Integrations > Webhooks > New Webhook > Copy URL.
# The address lets anyone who has it post to that channel, so keep it only in .env. Then remove the # on both lines.
# COMPOSE_PROFILES=discord
# DISCORD_WEBHOOK_URL=

# Which network addresses the ports listen on. The default is all of them. On a server set BIND_ADDRESS=127.0.0.1 so
# that only the console stays reachable from outside (docs/DEPLOY.md).
# BIND_ADDRESS=127.0.0.1
# FRONTEND_BIND_ADDRESS=0.0.0.0

# Host ports, if one is already in use
# SIMULATOR_PORT=8000
# BACKEND_PORT=8080
# FRONTEND_PORT=3000
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3001
# BENCH_SIMULATOR_PORT=8001

# Grafana admin password (anonymous visitors get read-only access)
# GRAFANA_ADMIN_PASSWORD=
