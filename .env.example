# Copy to .env and adjust. Nothing here is a secret; keep real secrets out of git.

# Simulator the backend reads from
SIMULATOR_URL=http://localhost:8000

# Simulator pacing (used by simulator/docker-compose.yml)
SIMULATION_SPEED=8
TICK_MINUTES=15
SIMULATOR_START_MODE=paused

# Shared secret for approve, reject and control endpoints (header X-Operator-Token); empty disables them
OPERATOR_TOKEN=

# Backend tuning (seconds)
REQUEST_TIMEOUT=3
POLL_INTERVAL=0.5
REFRESH_MAX_AGE=5
READY_MAX_AGE=15

# Allocation policy: lp (linear programme, falls back to greedy, then rules), greedy or rules
ALLOCATOR=lp
